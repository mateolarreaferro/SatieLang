comment
RadioPlay.sat
HomeWork 3 - 220A: Computer Generated Sound
This program is written in the Satie Domain Specific Language for Audio in Unity
endcomment


4 * oneshot random/radio every 5to25
    volume gobetween(0to0.01and0.1to0.2 as inquad in 20)
    pitch gobetween(0.5and1.2to1.5 as inquad in 30)
    move  x -20to20 z -60to60 speed 0.1to0.5
    visual cube


group phrase
volume goto(1and0 in 120)
    2 * oneshot mphrases/1to3 every 15to25
        start 10
        pitch 0.5
        volume goto(0and0.4 as inquad in 2)
        move x -25to15 y 0to10 z -25to25 speed 0.2to0.6
        visual trail
    2 * oneshot mphrases/1to3 every 15to25
        start 20
        pitch 2
        volume goto(0and0.2 as inquad in 2)
        move fly
        visual trail

group drones
volume goto(1and0 as inquad in 120)
    loop music/drone
        volume goto(0and0.3 as incubic in 15)
        pitch 0.5
        move x -15to15 y 0to10 z -5to5 speed 0.2to0.6
        visual sphere
    loop music/drone
        start 20
        volume goto(0and0.3 as incubic in 15)
        pitch 1
        move fly speed 0.2to0.6
        visual sphere
    loop music/drone
        start 40
        volume goto(0and0.3 in 15)
        pitch 1.5
        move fly
        visual sphere
