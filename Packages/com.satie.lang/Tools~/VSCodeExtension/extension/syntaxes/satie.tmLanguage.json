{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Satie",
    "scopeName": "source.satie",
    "patterns": [
        {
            "include": "#block-comments"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#groups"
        },
        {
            "include": "#statements"
        },
        {
            "include": "#properties"
        },
        {
            "include": "#interpolation"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "block-comments": {
            "patterns": [
                {
                    "name": "comment.block.satie",
                    "begin": "^\\s*comment\\b",
                    "end": "^\\s*endcomment\\b",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.comment.begin.satie"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "keyword.control.comment.end.satie"
                        }
                    }
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.satie",
                    "match": "#.*$"
                }
            ]
        },
        "groups": {
            "patterns": [
                {
                    "name": "meta.group.satie",
                    "match": "^\\s*(group)(?:\\s+(\\w+))?\\s*(:)?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.group.satie"
                        },
                        "2": {
                            "name": "entity.name.group.satie"
                        },
                        "3": {
                            "name": "punctuation.separator.colon.satie"
                        }
                    }
                },
                {
                    "name": "keyword.control.group.satie",
                    "match": "^\\s*(endgroup)\\b"
                }
            ]
        },
        "statements": {
            "patterns": [
                {
                    "name": "meta.statement.loop.satie",
                    "match": "^\\s*(?:(\\d+)\\s*(\\*)\\s*)?(loop)\\s+([\\w\\/]+)",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.count.satie"
                        },
                        "2": {
                            "name": "keyword.operator.multiplication.satie"
                        },
                        "3": {
                            "name": "keyword.control.statement.satie"
                        },
                        "4": {
                            "name": "string.unquoted.path.satie"
                        }
                    }
                },
                {
                    "name": "meta.statement.oneshot.satie",
                    "match": "^\\s*(?:(\\d+)\\s*(\\*)\\s*)?(oneshot)\\s+([\\w\\/]+)",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.count.satie"
                        },
                        "2": {
                            "name": "keyword.operator.multiplication.satie"
                        },
                        "3": {
                            "name": "keyword.control.statement.satie"
                        },
                        "4": {
                            "name": "string.unquoted.path.satie"
                        }
                    }
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "name": "meta.property.dsp.satie",
                    "match": "\\b(reverb|delay|filter|distortion|eq)\\b",
                    "captures": {
                        "1": {
                            "name": "support.function.dsp.satie"
                        }
                    }
                },
                {
                    "name": "meta.property.satie",
                    "match": "\\b(volume|pitch|starts_at|start|end|duration|fade_in|fade_out|every|overlap|persistent|mute|solo|randomstart|random_start|visual|move|color)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.satie"
                        }
                    }
                }
            ]
        },
        "interpolation": {
            "patterns": [
                {
                    "name": "entity.name.function.interpolation.satie",
                    "match": "\\b(interpolate|goto|gobetween)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.timing.satie",
                    "match": "\\b(every|and|as|in|for|ever|at|speed)\\b"
                },
                {
                    "name": "keyword.other.dsp.parameter.satie",
                    "match": "\\b(wet|drywet|time|feedback|pingpong|mode|cutoff|resonance|drive|size|roomsize|damp|damping|fade|low|mid|high|gain|freq|frequency)\\b"
                },
                {
                    "name": "keyword.other.dsp.mode.satie",
                    "match": "\\b(lowpass|highpass|bandpass|notch|peak|softclip|hardclip|tanh|cubic|asymmetric)\\b"
                },
                {
                    "name": "keyword.other.movement.satie",
                    "match": "\\b(walk|fly|pos|x|y|z)\\b"
                },
                {
                    "name": "keyword.other.visual.satie",
                    "match": "\\b(trail|sphere|cube|cylinder|capsule|object)\\b"
                },
                {
                    "name": "keyword.other.color.channel.satie",
                    "match": "\\b(red|green|blue)\\b"
                },
                {
                    "name": "constant.other.color.name.satie",
                    "match": "\\b(white|black|gray|grey|cyan|magenta|yellow|orange|purple|pink|brown)\\b"
                },
                {
                    "name": "constant.other.color.hex.satie",
                    "match": "#[0-9A-Fa-f]{6}\\b"
                },
                {
                    "name": "entity.name.ease.satie",
                    "match": "\\b(linear|inquad|outquad|inoutquad|incubic|outcubic|inoutcubic|inquart|outquart|inoutquart|inquint|outquint|inoutquint|insine|outsine|inoutsine|inexpo|outexpo|inoutexpo|incirc|outcirc|inoutcirc|inelastic|outelastic|inoutelastic|inback|outback|inoutback|inbounce|outbounce|inoutbounce)\\b"
                },
                {
                    "name": "constant.language.boolean.satie",
                    "match": "\\b(true|false|t|f)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.range.satie",
                    "match": "-?\\d+(?:\\.\\d+)?to-?\\d+(?:\\.\\d+)?"
                },
                {
                    "name": "constant.numeric.satie",
                    "match": "-?\\d+(?:\\.\\d+)?"
                }
            ]
        }
    }
}
